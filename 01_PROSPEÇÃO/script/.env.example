# Copia para .env e preenche. NUNCA commitar .env

# Google Places API key (Cloud Console → Credentials)
# Restrições recomendadas:
#   - Application restrictions: None (backend) OU IP addresses do servidor
#   - API restrictions: Places API
GOOGLE_PLACES_API_KEY=AIza...

# Token partilhado para autenticar ao Backoffice (POST /api/leads/ingest,
# /api/scrape/progress, /api/scrape/done-combos). Igual ao INGEST_TOKEN do
# .env.local do Backoffice.
INGEST_TOKEN=qualquer-string-secreta-longa-aleatoria

# URL do Backoffice. Default localhost:3010 em dev. Em produção:
# BACKOFFICE_URL=https://backoffice.smarthivesolutions.pt
BACKOFFICE_URL=http://localhost:3010
